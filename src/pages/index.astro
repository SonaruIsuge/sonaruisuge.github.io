---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import heroPhoto from "../assets/photo.png";
import cvFile from "../assets/CV/CV_YiHo_Chen_2026.pdf";

import translation from "../data/translation.json";
import aboutData from "../data/about.json";
---

<Layout title={`Home | Yi-Ho Chen - Portfolio`}>
	<Header />

	<main class="hud-main min-h-screen px-4 sm:px-6 md:px-6">
		<section
			class="max-w-3xl mx-auto min-h-[calc(100vh-5rem)] flex flex-col justify-center pt-32 sm:pt-48 pb-16 sm:pb-24 fade-in"
		>
			<div class="flex flex-col items-center gap-6 sm:gap-8 text-center">
				<div
					class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4"
				>
					<div
						class="w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32 rounded-full bg-gray-100 dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center overflow-hidden animated-border always-visible flex-shrink-0 shadow-lg dark:shadow-white/20"
					>
						<img
							src={heroPhoto.src}
							alt="Portrait of Yi-Ho Chen"
							class="w-full h-full object-cover"
							onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
						/>
						<span
							class="text-2xl sm:text-3xl md:text-4xl text-gray-500 dark:text-gray-400 hidden"
							>?</span
						>
					</div>
					<div
						class="hud-status animated-border always-visible px-3 sm:px-4 py-2 rounded-full border border-gray-300 dark:border-gray-600 h-fit"
					>
						<p
							class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white whitespace-nowrap"
							data-en={translation.about.availability.en}
							data-jp={translation.about.availability.jp}
						>
							{translation.about.availability.en}
						</p>
					</div>
				</div>
				<div>
					<p
						class="text-xs sm:text-sm font-medium text-gray-600 dark:text-gray-400 mb-2"
						data-en={translation.about.greeting.en}
						data-jp={translation.about.greeting.jp}
					>
						{translation.about.greeting.en}
					</p>
					<h1
						class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 sm:mb-6 px-2 sm:px-0"
						data-en={aboutData.about.name.en}
						data-jp={aboutData.about.name.jp}
					>
						{aboutData.about.name.en}
					</h1>
					<p
						class="text-sm sm:text-base text-gray-600 dark:text-gray-400 max-w-lg mx-auto mb-4 sm:mb-6 px-2 sm:px-0"
						data-en={aboutData.about.description.en}
						data-jp={aboutData.about.description.jp}
					>
						{aboutData.about.description.en}
					</p>
					<div
						class="flex flex-wrap gap-2 sm:gap-3 justify-center px-2 sm:px-0"
					>
						<a
							href="/projects"
							class="hud-button hud-button-primary cursor-pointer px-4 sm:px-5 py-2 sm:py-2.5 text-sm sm:text-base bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium rounded-full hover:animated-bg transition-all"
							data-en={translation.about.viewProjects.en}
							data-jp={translation.about.viewProjects.jp}
						>
							{translation.about.viewProjects.en}
						</a>
						<a
							href="/contact"
							class="hud-button hud-button-secondary animated-border cursor-pointer px-4 sm:px-5 py-2 sm:py-2.5 text-sm sm:text-base border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white font-medium rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
							data-en={translation.about.getInTouch.en}
							data-jp={translation.about.getInTouch.jp}
						>
							{translation.about.getInTouch.en}
						</a>
						<a
							href={cvFile}
							download="CV_Yiho_Chen.pdf"
							class="hud-button hud-button-tertiary animated-border cursor-pointer px-4 sm:px-5 py-2 sm:py-2.5 text-sm sm:text-base border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white font-medium rounded-full transition-colors"
							data-en={translation.about.downloadCv.en}
							data-jp={translation.about.downloadCv.jp}
						>
							{translation.about.downloadCv.en}
							<span aria-hidden="true">↓</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<section
			class="max-w-3xl mx-auto py-12 sm:py-16 border-t border-gray-200 dark:border-gray-700 parallax-section fade-in px-2 sm:px-0"
		>
			<h2
				class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6 sm:mb-8"
				data-en={translation.about.aboutMe.en}
				data-jp={translation.about.aboutMe.jp}
			>
				{translation.about.aboutMe.en}
			</h2>
			<div
				class="space-y-3 sm:space-y-4 text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-400 whitespace-pre-line"
				data-en={aboutData.about.aboutDesc.en}
				data-jp={aboutData.about.aboutDesc.jp}
			>
				{aboutData.about.aboutDesc.en}
			</div>
		</section>

		<section
			class="max-w-3xl mx-auto py-12 sm:py-16 border-t border-gray-200 dark:border-gray-700 parallax-section fade-in px-2 sm:px-0"
		>
			<h2
				class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6 sm:mb-8"
				data-en={translation.about.tech.en}
				data-jp={translation.about.tech.jp}
			>
				{translation.about.tech.en}
			</h2>

			<div class="tech-ticker-container">
				<div class="tech-ticker-content">
					<!-- First set -->
					{
						aboutData.techStack.map((tech) => (
							<div class="hud-chip cursor-pointer px-4 py-2 rounded-full bg-transparent border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 transition-all hover:scale-105 whitespace-nowrap">
								<p class="text-sm font-medium text-gray-900 dark:text-white">
									{tech}
								</p>
							</div>
						))
					}

					<!-- Second set for seamless looping -->
					{
						aboutData.techStack.map((tech) => (
							<div class="hud-chip cursor-pointer px-4 py-2 rounded-full bg-transparent border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 transition-all hover:scale-105 whitespace-nowrap">
								<p class="text-sm font-medium text-gray-900 dark:text-white">
									{tech}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<script>
		document.addEventListener("DOMContentLoaded", () => {
			const observerOptions = {
				root: null,
				rootMargin: "0px",
				threshold: 0.1,
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("visible");
					}
				});
			}, observerOptions);

			document.querySelectorAll(".fade-in").forEach((el) => {
				observer.observe(el);
			});

			window.addEventListener("scroll", () => {
				const scrolled = window.pageYOffset;
				document
					.querySelectorAll(".parallax-section")
					.forEach((section) => {
						const speed = 0.1;
						(section as HTMLElement).style.transform =
							`translateY(${scrolled * speed}px)`;
					});
			});
		});
	</script>
</Layout>
